Bootstrap: docker
From: debian:bookworm-slim
Stage: builder

%files
    ./src/papi-7.2.0 /var/lib/rapl/papi-7.2.0
    ./src/rapl_plot /var/lib/rapl/rapl_plot

%post
    export PAPI_VERSION=7.2.0
    export RAPL_HOME=/var/lib/rapl
    export PAPI_HOME=${RAPL_HOME}/papi-${PAPI_VERSION}
    export RAPL_SRC=/var/lib/rapl/rapl_plot

    apt-get update && apt-get install -y --no-install-recommends build-essential

    # Compile PAPI
    cd ${PAPI_HOME}/src
    chmod +x configure
    ./configure --with-components="rapl"
    make

    # Compile RAPL tool
    cd ${RAPL_SRC}
    rm -f rapl_plot rapl_plot.o
    make CC="gcc -static -s"

Bootstrap: docker
From: busybox:1.37
Stage: final

%files from builder
    /var/lib/rapl/rapl_plot/rapl_plot /usr/local/bin/rapl_plot

%post
    # Name resolution of the static binary
    echo "hosts: files dns" > /etc/nsswitch.conf

%runscript
    exec /usr/local/bin/rapl_plot "$@"

%startscript
    exec /usr/local/bin/rapl_plot "$@"
